<Window x:Class="PolarAd.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Polar Ad" Icon="pack://application:,,,/Assets/polarad.ico" Height="700" Width="1040" MinWidth="880" MinHeight="600"
        Background="{StaticResource IvoryBrush}"
        Closing="Window_Closing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource NavyBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,22">
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="White">
                        <Run Text="Polar "/><Run Text="Ad" Foreground="{StaticResource GoldBrush}"/>
                    </TextBlock>
                    <TextBlock Text="조용히 광고를 걸러냅니다." FontSize="12" Foreground="#9FB3C4" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <RadioButton x:Name="NavHome" GroupName="Nav" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="홈" IsChecked="True" Click="NavHome_Click"/>
                    <RadioButton x:Name="NavProtection" GroupName="Nav" Style="{StaticResource NavButton}" Tag="&#xE83D;" Content="보호" Click="NavProtection_Click"/>
                    <RadioButton x:Name="NavBlockList" GroupName="Nav" Style="{StaticResource NavButton}" Tag="&#xE8FD;" Content="차단 목록" Click="NavBlockList_Click"/>
                    <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="설정" Click="NavSettings_Click"/>
                    <RadioButton x:Name="NavAbout" GroupName="Nav" Style="{StaticResource NavButton}" Tag="&#xE946;" Content="정보" Click="NavAbout_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pages -->
        <Grid Grid.Column="1" Margin="32,28,32,24">

            <!-- Home -->
            <Grid x:Name="HomePage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock x:Name="ProtectionTitle" Text="보호 중" FontSize="30" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                    <TextBlock x:Name="ProtectionSubtitle" Text="더 깔끔하고 조용한 인터넷 환경입니다." FontSize="14" Style="{StaticResource BodyMuted}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="AdminStatusText" Foreground="#9B2C2C" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource GreenSoftBrush}" Margin="0,0,16,0">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource GreenBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="광고 차단" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                            <TextBlock Text="이 PC의 모든 브라우저에서 광고와 추적 요청을 차단합니다."
                                       Style="{StaticResource BodyMuted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="ProtectionToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      Click="ProtectionToggle_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="&#xE8F8;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#B88A2E"/>
                            <TextBlock x:Name="StatBlocked" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="차단한 요청" Style="{StaticResource BodyMuted}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#B88A2E"/>
                            <TextBlock x:Name="StatBlocklist" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="차단 목록의 도메인" Style="{StaticResource BodyMuted}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#B88A2E"/>
                            <TextBlock x:Name="StatAllowed" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="허용한 사이트" Style="{StaticResource BodyMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="전체 보기" Style="{StaticResource SecondaryButton}" Click="ViewAllLog_Click"/>
                            <TextBlock Text="최근 활동" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>
                        <ItemsControl x:Name="RecentActivityList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{Binding GlyphBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{StaticResource NavyBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TimestampDisplay}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Full activity log -->
            <Grid x:Name="LogPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Left" Content="← 뒤로" Style="{StaticResource SecondaryButton}" Click="BackFromLog_Click" Margin="0"/>
                    <TextBlock Text="활동 기록" FontSize="24" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="새로고침" Style="{StaticResource SecondaryButton}" Click="RefreshLogButton_Click"/>
                            <Button Content="선택한 사이트 허용" Style="{StaticResource SecondaryButton}" Click="AllowSelectedLogDomainButton_Click"/>
                            <Button Content="기록 지우기" Style="{StaticResource SecondaryButton}" Click="ClearLogButton_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="LogDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  BorderThickness="0" Background="Transparent" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="시간" Binding="{Binding TimestampDisplay}" Width="150"/>
                                <DataGridTextColumn Header="앱" Binding="{Binding AppName}" Width="140"/>
                                <DataGridTextColumn Header="도메인" Binding="{Binding Domain}" Width="*"/>
                                <DataGridTextColumn Header="결과" Binding="{Binding DecisionDisplay}" Width="150"/>
                                <DataGridTextColumn Header="적용 규칙" Binding="{Binding MatchedRule}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Protection -->
            <ScrollViewer x:Name="ProtectionPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="보호" FontSize="30" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Windows 시작 시 자동 실행" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="AutoStartCheckBox" Content="로그인할 때 자동으로 보호 켜기 (관리자 권한, UAC 창 없음)"
                                      Margin="0,4,0,8" Checked="AutoStartCheckBox_Changed" Unchecked="AutoStartCheckBox_Changed"/>
                            <TextBlock Style="{StaticResource BodyMuted}" FontSize="12">
                                작업 스케줄러에 등록해 조용히 시작되며, 작업 관리자의 시작 프로그램 목록에도 표시되도록 시작 항목을 함께 등록합니다.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="차단 목록 자동 업데이트" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Polar Ad가 실행 중일 때 차단 목록을 새로 받아오는 주기(시간)입니다." Style="{StaticResource BodyMuted}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox x:Name="AutoUpdateIntervalTextBox" Width="70" VerticalContentAlignment="Center" Padding="6,4"/>
                                <Button Content="저장" Style="{StaticResource PrimaryButton}" Click="SaveAutoUpdateIntervalButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="네트워크 복구" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource BodyMuted}" Margin="0,0,0,4">
                                보호가 켜져 있으면 Polar Ad가 이 PC의 DNS를 자기 자신으로 바꿉니다. 보호를 끄거나 종료하면 원래 DNS로 돌아갑니다. 비정상 종료 후 인터넷이 안 되면 아래 버튼을 누르세요.
                            </TextBlock>
                            <Button Content="지금 네트워크 설정 복구" Style="{StaticResource SecondaryButton}" Click="EmergencyRestoreButton_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Block List -->
            <ScrollViewer x:Name="BlockListPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="차단 목록" FontSize="30" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="BlocklistInfoText" Foreground="{StaticResource NavyBrush}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="UpdateBlocklistButton" Content="지금 업데이트" Style="{StaticResource PrimaryButton}" Click="UpdateBlocklistButton_Click" Margin="0,0,8,0"/>
                                <TextBlock x:Name="BlocklistUpdateStatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="내 차단 규칙" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="여기에 추가한 도메인과 그 하위 도메인은 항상 차단됩니다." Style="{StaticResource BodyMuted}"/>
                                <DockPanel Margin="0,10,0,8">
                                    <Button DockPanel.Dock="Right" Content="추가" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="AddBlockRuleButton_Click"/>
                                    <TextBox x:Name="NewBlockRuleTextBox" VerticalContentAlignment="Center" Padding="6,4"/>
                                </DockPanel>
                                <ListBox x:Name="BlockRulesListBox" Height="260" BorderThickness="0" Background="Transparent"/>
                                <Button Content="선택 항목 삭제" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="RemoveBlockRuleButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="허용한 사이트" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="사이트가 깨지면 여기에 추가하세요. 바로 차단에서 제외됩니다." Style="{StaticResource BodyMuted}"/>
                                <DockPanel Margin="0,10,0,8">
                                    <Button DockPanel.Dock="Right" Content="추가" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="AddAllowEntryButton_Click"/>
                                    <TextBox x:Name="NewAllowEntryTextBox" VerticalContentAlignment="Center" Padding="6,4"/>
                                </DockPanel>
                                <ListBox x:Name="AllowlistListBox" Height="260" BorderThickness="0" Background="Transparent"/>
                                <Button Content="선택 항목 삭제" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="RemoveAllowEntryButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="설정" FontSize="30" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="차단 목록 주소" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="한 줄에 주소 하나씩 입력하세요. hosts 형식과 AdBlock 형식 목록을 모두 지원합니다." Style="{StaticResource BodyMuted}"/>
                            <TextBox x:Name="BlocklistSourcesTextBox" Height="120" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,10,0,0" Padding="6"/>
                            <Button Content="주소 저장" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SaveBlocklistSourcesButton_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- About -->
            <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="정보" FontSize="30" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource NavyBrush}">
                                <Run Text="Polar "/><Run Text="Ad" Foreground="#B88A2E"/>
                            </TextBlock>
                            <TextBlock Text="조용히 광고를 걸러냅니다." FontSize="14" Style="{StaticResource BodyMuted}" Margin="0,2,0,12"/>
                            <TextBlock Style="{StaticResource BodyMuted}" Margin="0,0,0,8">
                                브라우저 확장 프로그램 없이, DNS 단계에서 이 PC의 모든 브라우저 광고와 추적 요청을 차단합니다.
                                광고가 별도 도메인에서 오는 경우에 가장 잘 동작합니다. 콘텐츠와 같은 도메인에서 나오는 광고는 계속 보일 수 있습니다.
                            </TextBlock>
                            <TextBlock Text="Version 0.2.0" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
